OPENAI_API_KEY=your_api_key

# Frontend -> backend proxy. Leave blank to use the legacy in-process Next API routes.
FRONTEND_BACKEND_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FRONTEND_BACKEND_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CALLCENTER_BACKEND_WS_URL=ws://127.0.0.1:8000/api/v1/callcenter/realtime/ws

# Python backend runtime
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VOICE_PROVIDER=cascaded_pipeline
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_RESPONSES_MODEL=gpt-4.1
OPENAI_CASCADED_LLM_MODEL=gpt-4.1-mini

# Cascaded voice research runtime: Deepgram STT -> OpenAI agent -> ElevenLabs TTS
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_STT_ALT_MODEL=nova-3
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_ALT_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_CALLCENTER=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_BILLING=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_TECHNICAL_SUPPORT=nPczCjzI2devNBz1zQrb
ELEVENLABS_VOICE_RETENTION=LcfcDJNUP1GQjkzn1xUU
ELEVENLABS_VOICE_SUPERVISOR=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_HUMAN_ESCALATION=TxGEqnHWrfWFTfGW9XjX
CASCADED_INPUT_SAMPLE_RATE=24000
CASCADED_OUTPUT_SAMPLE_RATE=24000
CASCADED_PROVIDER_TIMEOUT_SECONDS=30
CALLCENTER_SESSION_DB_PATH=backend/.data/callcenter_sessions.db
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=atenxion_callcenter
LOG_LEVEL=INFO
